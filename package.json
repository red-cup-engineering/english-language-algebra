{
  "name": "@emsenn/english-language-algebra",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "english-language: English as a language fiber — its lexicon, morphology, reference, attachment and segmentation tables, compiled and ready for the settlement engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/english-language.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ../../scripts/package-boundary/copy-dmts-to-dts.mjs dist",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test \".tmp/test-dist/**/*.test.mjs\"",
    "audit:boundary": "node ../../scripts/package-boundary/audit-package-boundary.mjs .",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "import": "./dist/bundle.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/language-algebra": "workspace:*",
    "@emsenn/language-topology": "workspace:*",
    "@emsenn/language-codecs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
